---
// Layout de "Setup por Entorno de Desarrollo" — recomendación de hardware según el motor/lenguaje.
// Diseño técnico y profesional, sin estética "gaming"/RGB.
interface MonitorSlot {
  role: string;
  purpose: string;
  spec: string;
}

interface Props {
  title: string;
  intro: string;
  monitors: MonitorSlot[];
  peripheralsNote: string;
}

const { title, intro, monitors, peripheralsNote } = Astro.props;
---

<section class="bg-slate-50 dark:bg-slate-800 p-6 sm:p-10">
  <h2 class="mb-3">{title}</h2>
  <p class="text-slate-700 dark:text-slate-300 mb-8 max-w-[60ch]">{intro}</p>

  <!-- Esquema visual de disposición de monitores -->
  <div class="grid sm:grid-cols-[2fr_1fr] gap-2 mb-2">
    {monitors.map((m) => (
      <div class="bg-white dark:bg-slate-900 p-5 flex flex-col justify-between min-h-[160px]">
        <span class="inline-flex w-fit items-center bg-slate-900 dark:bg-slate-50 text-white dark:text-slate-900 text-sm font-semibold px-2.5 py-1">
          {m.role}
        </span>
        <div>
          <p class="text-lg text-slate-900 dark:text-slate-50">{m.purpose}</p>
          <p class="font-metric text-slate-500 mt-1">{m.spec}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white dark:bg-slate-900 p-6">
    <h3 class="mb-2">Periféricos esenciales</h3>
    <p class="text-slate-700 dark:text-slate-300 max-w-[60ch]">{peripheralsNote}</p>
  </div>
</section>
