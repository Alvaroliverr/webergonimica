---
import Layout from "../layouts/Layout.astro";

const needs = [
  { label: "Tengo dolor lumbar", href: "/sillas-ergonomicas", icon: "M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4" },
  { label: "Busco un escritorio elevable", href: "/escritorios-elevables", icon: "M4 19h16M6 19V9h12v10M9 9V5h6v4" },
  { label: "Quiero mejorar mi setup de código", href: "/setups-programacion", icon: "M9.75 17 15 12l-5.25-5M4 19h16" },
];

const categories = [
  { name: "Sillas ergonómicas", href: "/sillas-ergonomicas", desc: "Soporte lumbar, malla transpirable y mecanismos de basculación.", image: "https://placehold.co/400x300/eef2ff/4338ca?text=Sillas" },
  { name: "Escritorios elevables", href: "/escritorios-elevables", desc: "Sit-stand desks con motores silenciosos y memoria de altura.", image: "https://placehold.co/400x300/ecfdf5/047857?text=Escritorios" },
  { name: "Monitores y accesorios", href: "/monitores", desc: "Paneles, brazos articulados y soportes para reducir tensión cervical.", image: "https://placehold.co/400x300/f8fafc/475569?text=Monitores" },
];
---

<Layout
  title="SetupPro: ergonomía y setups para teletrabajo"
  description="Análisis independientes de sillas, escritorios y accesorios para programadores y teletrabajadores."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 space-y-20">
    <section class="text-center max-w-2xl mx-auto">
      <span class="inline-block text-xs font-semibold text-brand-600 dark:text-cyan-400 bg-brand-50 dark:bg-brand-700/20 rounded-full px-3 py-1 mb-5">
        Análisis independientes, sin sesgo de marca
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-slate-50 leading-tight mb-5">
        El setup que tu espalda y tu código merecen
      </h1>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        Probamos sillas, escritorios y accesorios de oficina durante semanas de uso real para que
        elijas con datos, no con marketing.
      </p>
    </section>

    <section>
      <h2 class="text-sm font-semibold text-slate-400 dark:text-slate-500 text-center uppercase tracking-wide mb-6">¿Cuál es tu necesidad?</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {needs.map((need) => (
          <a
            href={need.href}
            class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-700/50 bg-white dark:bg-slate-800 px-5 py-4 hover:shadow-md hover:scale-[1.01] transition-all duration-200"
          >
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 dark:bg-brand-700/20 text-brand-600 dark:text-cyan-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d={need.icon} />
              </svg>
            </span>
            <span class="font-medium text-slate-900 dark:text-slate-50 text-sm">{need.label}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 text-center mb-8">Explora por categoría</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="group rounded-2xl border border-slate-200 dark:border-slate-700/50 bg-white dark:bg-slate-800 overflow-hidden shadow-card hover:shadow-md hover:scale-[1.01] transition-all duration-200"
          >
            <img src={cat.image} alt={cat.name} class="w-full h-40 object-cover" loading="lazy" />
            <div class="p-5">
              <h3 class="font-semibold text-slate-900 dark:text-slate-50 mb-1.5">{cat.name}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{cat.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
