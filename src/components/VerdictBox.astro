---
// Caja de veredicto: lo esencial de la ficha en la primera pantalla.
import { resizeAmazonImage } from "../utils/image";

interface Spec {
  icon?: string;
  label: string;
  value: string;
}

interface Props {
  badge: string;
  productName: string;
  brand?: string;
  imageSrc: string;
  imageAlt: string;
  score: number; // sobre 10
  specs: Spec[];
  amazonUrl: string;
  priceNote?: string;
}

const {
  badge,
  productName,
  brand,
  imageSrc,
  imageAlt,
  score,
  specs,
  amazonUrl,
  priceNote = "Precio orientativo: confírmalo en Amazon.",
} = Astro.props;

const sub = [brand, badge].filter(Boolean).join(" · ");
---

<section class="vb wide">
  <div class="vb-img">
    <img
      src={resizeAmazonImage(imageSrc, 800)}
      alt={imageAlt}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      width="600"
      height="600"
    />
  </div>

  <div class="vb-body">
    <h1>{productName}</h1>
    {sub && <p class="vb-sub">{sub}</p>}

    <p class="vb-score">
      <span class="n font-metric">{score.toFixed(1)}</span>
      <span class="of font-metric">/ 10</span>
      <span class="lab">Puntuación ElDeskOps</span>
    </p>

    <ul class="vb-specs">
      {specs.map((spec) => (
        <li>
          <span class="k">{spec.label}</span>
          <span class="v font-metric">{spec.value}</span>
        </li>
      ))}
    </ul>

    <p class="vb-note">{priceNote}</p>
    <a class="btn vb-cta" href={amazonUrl} target="_blank" rel="sponsored nofollow">
      Consultar disponibilidad en Amazon
    </a>
  </div>
</section>

<style is:global>
  .vb {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: center;
  }
  .vb-img {
    background: var(--surface);
    aspect-ratio: 1 / 1;
    max-height: 74svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vb-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    mix-blend-mode: multiply;
  }
  :root.dark .vb-img { background: #ffffff; }
  :root.dark .vb-img img { mix-blend-mode: normal; }
  .vb-body h1 {
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.04;
  }
  .vb-sub {
    margin-top: 14px;
    font-size: var(--lead);
    color: var(--ink);
  }
  .vb-score {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 28px;
    color: var(--ink);
  }
  .vb-score .n { font-size: var(--head); line-height: 1; }
  .vb-score .of { color: var(--muted); }
  .vb-score .lab { margin-left: 8px; color: var(--muted); font-size: var(--small); }
  .vb-specs { list-style: none; margin: 24px 0 32px; padding: 0; }
  .vb-specs li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    min-height: 44px;
    padding: 8px 0;
    font-size: var(--small);
  }
  .vb-specs .k { color: var(--muted); }
  .vb-specs .v { color: var(--ink); text-align: right; }
  .vb-cta { min-height: 56px; width: 100%; }
  .vb { margin-bottom: 40px; }
  .vb-note { margin-bottom: 12px; font-size: var(--small); color: var(--muted); }
  @media (max-width: 959px) {
    .vb { grid-template-columns: 1fr; }
    .vb-img { max-height: 56svh; }
    .vb-body h1 { font-size: clamp(2rem, 6vw, 3.25rem); }
  }
</style>
