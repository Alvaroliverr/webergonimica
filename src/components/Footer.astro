---
import AffiliateDisclosure from "./AffiliateDisclosure.astro";

const columns = [
  {
    title: "Categorías",
    links: [
      { label: "Sillas ergonómicas", href: "/sillas-ergonomicas" },
      { label: "Escritorios elevables", href: "/escritorios-elevables" },
      { label: "Monitores y accesorios", href: "/monitores" },
    ],
  },
  {
    title: "Guías",
    links: [
      { label: "Cómo elegir una silla ergonómica", href: "/guias/como-elegir-silla-ergonomica" },
      { label: "Cómo elegir un escritorio elevable", href: "/guias/como-elegir-escritorio-elevable" },
      { label: "Qué monitor elegir para programar", href: "/guias/que-monitor-elegir-para-programar" },
      { label: "Ver todas las guías", href: "/guias" },
    ],
  },
];
---

<footer class="bg-slate-50 border-t border-slate-100 mt-24 dark:bg-slate-900 dark:border-slate-700/50 transition-colors duration-300">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 font-bold text-slate-900 text-lg mb-3 dark:text-slate-50">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 text-white text-sm font-mono dark:bg-slate-50 dark:text-slate-900">SP</span>
          SetupPro
        </div>
        <p class="text-sm text-slate-500 leading-relaxed dark:text-slate-400">
          Análisis independientes de ergonomía y setups de escritorio para teletrabajo.
        </p>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-4 dark:text-slate-50">{col.title}</h3>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors duration-200">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <AffiliateDisclosure />

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mt-8 pt-6 border-t border-slate-200 dark:border-slate-700/50">
      <p class="text-xs text-slate-400">© {new Date().getFullYear()} SetupPro. Todos los derechos reservados.</p>
      <p class="text-xs text-slate-400">Precios actualizados a diario. Sujetos a cambios sin previo aviso.</p>
    </div>
  </div>
</footer>
