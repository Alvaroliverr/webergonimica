---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import CrossCategoryLinks from "../../components/CrossCategoryLinks.astro";
import { getProductsByCategory } from "../../data/products";

const products = getProductsByCategory("escritorios-elevables").sort(
  (a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro
);

const rows = products.map((p) => ({
  imageSrc: p.imagen,
  name: p.nombre,
  badge: p.insignia,
  price: p.precio_aproximado,
  loadCapacity: p.capacidad_carga,
  heightRange: p.ajuste,
  warranty: p.garantia,
  score: p.puntuacion_setuppro,
  amazonUrl: p.amazon_affiliate_link,
}));

const reviews = products.map((p) => ({
  title: `${p.nombre}: análisis y opinión 2026`,
  href: `/escritorios-elevables/${p.id}`,
  excerpt: `${p.precio_aproximado} · ${p.valoracion_amazon}★ en Amazon (${p.num_opiniones.toLocaleString("es-ES")} opiniones) · Puntuación SetupPro ${p.puntuacion_setuppro.toFixed(1)}`,
}));
---

<Layout
  title="Top 10 escritorios elevables 2026: comparativa"
  description="Comparamos los 10 mejores escritorios elevables eléctricos para teletrabajo y programación. Memoria de altura, tamaño y precio."
  ogImage={products[0].imagen}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-10 sm:py-14 space-y-12">
    <nav>
      <Breadcrumbs items={[{ label: "Escritorios elevables", href: "/escritorios-elevables" }]} />
    </nav>

    <header>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-50 mb-4">Top 10 escritorios elevables para teletrabajo</h1>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
        Alternar entre sentado y de pie a lo largo del día reduce la fatiga acumulada en jornadas
        largas frente al ordenador. Comparamos escritorios eléctricos reales del mercado español,
        priorizando estabilidad del motor, tamaño del tablero y funciones extra como memorias de
        altura o gestión de cables.
      </p>
    </header>

    <section>
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Comparativa de los {products.length} mejores modelos</h2>
      <ComparisonTable rows={rows} />
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Reviews individuales</h2>
      <ul class="grid sm:grid-cols-2 gap-4">
        {reviews.map((review) => (
          <li>
            <a href={review.href} class="block rounded-xl border border-slate-200 dark:border-slate-700/50 bg-white dark:bg-slate-800 p-5 hover:shadow-md hover:scale-[1.01] transition-all duration-200">
              <h3 class="font-semibold text-slate-900 dark:text-slate-50 mb-1">{review.title}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400">{review.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CrossCategoryLinks currentCategory="escritorios-elevables" />
  </div>
</Layout>
