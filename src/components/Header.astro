---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { label: "Sillas", href: "/sillas-ergonomicas" },
  { label: "Escritorios", href: "/escritorios-elevables" },
  { label: "Monitores", href: "/monitores" },
  { label: "Guías", href: "/guias" },
];

const isHome = Astro.url.pathname === "/";
const bar = isHome
  ? "bg-[var(--field-1)] text-white"
  : "bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-50";
const link = isHome
  ? "text-white/80 hover:text-white"
  : "text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white";
---

<header class={`${bar} transition-colors duration-200`}>
  <div class={`mx-auto flex items-center justify-between h-16 pl-[var(--margin)] max-w-[1600px] ${isHome ? "pr-[var(--margin)]" : "pr-0"}`}>
    <a href="/" class="text-lg font-semibold tracking-tight">ElDeskOps</a>

    <nav class="hidden md:flex items-center gap-8 text-base" aria-label="Principal">
      {nav.map((item) => (
        <a href={item.href} class={`${link} transition-colors duration-150`}>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 h-full">
      <ThemeToggle />
      {!isHome && <a
        href="/#hoja"
        class="inline-flex items-center h-full pl-5 pr-[var(--margin)] bg-[var(--accent)] text-[var(--accent-ink)] text-base font-semibold hover:brightness-95 transition-[filter] duration-150"
      >
        Ver los 30 productos
      </a>}
    </div>
  </div>

  <nav class="md:hidden flex gap-6 overflow-x-auto no-scrollbar px-[var(--margin)] pb-3 text-base" aria-label="Principal móvil">
    {nav.map((item) => (
      <a href={item.href} class={`${link} inline-flex items-center h-10 shrink-0`}>{item.label}</a>
    ))}
  </nav>
</header>
