---
import { resizeAmazonImage } from "../utils/image";

interface Row {
  imageSrc: string;
  name: string;
  badge?: string;
  price: string;
  previousPrice?: string;
  onSale?: boolean;
  saleBadge?: string;
  loadCapacity: string;
  heightRange: string;
  warranty: string;
  score: number;
  amazonUrl: string;
}

interface Props {
  rows: Row[];
  loadCapacityLabel?: string;
  heightRangeLabel?: string;
}

const {
  rows,
  loadCapacityLabel = "Carga máx.",
  heightRangeLabel = "Rango altura",
} = Astro.props;

// Valor numérico del precio para poder ordenar (ej. "179,99 €" -> 179.99)
function priceValue(price: string): number {
  const match = price.replace(/\./g, "").match(/[\d,]+/);
  return match ? parseFloat(match[0].replace(",", ".")) : 0;
}

const sortBtn =
  "sort-btn h-11 px-4 text-base font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 aria-pressed:bg-slate-900 aria-pressed:text-white dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:aria-pressed:bg-slate-50 dark:aria-pressed:text-slate-900 transition-colors duration-150";
---

<div class="comparison-table-wrapper" data-comparison-table>
  <!-- Ordenación -->
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <button type="button" data-sort="default" class={sortBtn} aria-pressed="true">
      Recomendados
    </button>
    <button type="button" data-sort="score-desc" class={sortBtn} aria-pressed="false">
      Mejor puntuación
    </button>
    <button type="button" data-sort="price-asc" class={sortBtn} aria-pressed="false">
      Precio: menor a mayor
    </button>
    <button type="button" data-sort="price-desc" class={sortBtn} aria-pressed="false">
      Precio: mayor a menor
    </button>
  </div>

  <!-- Escritorio: tabla -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-base">
      <thead class="text-slate-900 dark:text-slate-50 border-b border-slate-200 dark:border-slate-800"> <!-- taste-skill-ignore -->
        <tr>
          <th class="text-left font-semibold px-4 py-3 w-[340px]">Producto</th>
          <th class="text-right font-semibold px-4 py-3">Precio</th>
          <th class="text-right font-semibold px-4 py-3">{loadCapacityLabel}</th>
          <th class="text-right font-semibold px-4 py-3">{heightRangeLabel}</th>
          <th class="text-right font-semibold px-4 py-3">Garantía</th>
          <th class="text-right font-semibold px-4 py-3">Puntuación</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody data-sortable-body>
        {rows.map((row) => (
          <tr
            data-price={priceValue(row.price)}
            data-score={row.score}
            class="odd:bg-slate-50 dark:odd:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-150"
          >
            <td class="px-4 py-3">
              <div class="flex items-center gap-4">
                <img src={resizeAmazonImage(row.imageSrc, 100)} alt={row.name} class="h-12 w-12 shrink-0 object-contain bg-white p-1" width="48" height="48" loading="lazy" />
                <div>
                  <span class="text-slate-900 dark:text-slate-50 block font-medium">{row.name}</span>
                  {row.badge && <span class="block text-xs text-slate-500">{row.badge}</span>}
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-right font-metric whitespace-nowrap">
              {row.onSale && (
                <span class="inline-block px-1.5 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 mr-1.5">
                  {row.saleBadge ?? "Oferta"}
                </span>
              )}
              <span class={row.onSale ? "text-emerald-600 dark:text-emerald-400 font-bold" : "text-slate-900 dark:text-slate-50"}>
                {row.price}
              </span>
              {row.previousPrice && (
                <span class="block text-xs line-through text-slate-400">
                  {row.previousPrice}
                </span>
              )}
            </td>
            <td class="px-4 py-3 text-right font-metric text-slate-600 dark:text-slate-300">{row.loadCapacity}</td>
            <td class="px-4 py-3 text-right font-metric text-slate-600 dark:text-slate-300">{row.heightRange}</td>
            <td class="px-4 py-3 text-right font-metric text-slate-600 dark:text-slate-300">{row.warranty}</td>
            <td class="px-4 py-3 text-right font-metric whitespace-nowrap text-slate-900 dark:text-slate-50 font-semibold">{row.score.toFixed(1)}</td>
            <td class="pl-4 pr-0 py-3 text-right">
              <a href={row.amazonUrl} target="_blank" rel="sponsored nofollow" class="btn !min-h-[44px] !px-4 whitespace-nowrap">
                Ver precio
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Móvil: lista compacta -->
  <ul class="md:hidden" data-sortable-body>
    {rows.map((row) => (
      <li data-price={priceValue(row.price)} data-score={row.score} class="flex items-center gap-3 py-3">
        <img src={resizeAmazonImage(row.imageSrc, 100)} alt={row.name} class="h-14 w-14 shrink-0 object-contain bg-slate-50 dark:bg-white p-1" width="56" height="56" loading="lazy" />
        <div class="min-w-0 flex-1">
          <p class="text-base leading-tight font-medium text-slate-900 dark:text-slate-50">{row.name}</p>
          <p class="font-metric text-slate-500 text-sm mt-0.5">
            {row.onSale && (
              <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 mr-1">
                {row.saleBadge ?? "Oferta"}
              </span>
            )}
            <span class={row.onSale ? "text-emerald-600 dark:text-emerald-400 font-bold" : ""}>{row.price}</span>
            {row.previousPrice && <span class="line-through text-slate-400 text-xs ml-1">{row.previousPrice}</span>}
            {" · "}puntuación {row.score.toFixed(1)}
          </p>
        </div>
        <a href={row.amazonUrl} target="_blank" rel="sponsored nofollow" class="btn shrink-0 !min-h-[44px] !px-3">
          Ver precio
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  (function () {
    const wrappers = document.querySelectorAll<HTMLElement>("[data-comparison-table]");

    wrappers.forEach((wrapper) => {
      const buttons = wrapper.querySelectorAll<HTMLButtonElement>(".sort-btn");
      const tbody = wrapper.querySelector<HTMLElement>("tbody[data-sortable-body]");
      const ul = wrapper.querySelector<HTMLElement>("ul[data-sortable-body]");

      if (!tbody && !ul) return;

      const tableRows = tbody ? Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr")) : [];
      const listItems = ul ? Array.from(ul.querySelectorAll<HTMLLIElement>("li")) : [];

      function applySort(type: string) {
        function sortElements<T extends HTMLElement>(elements: T[]): T[] {
          return elements.slice().sort((a, b) => {
            const priceA = parseFloat(a.dataset.price || "0");
            const priceB = parseFloat(b.dataset.price || "0");
            const scoreA = parseFloat(a.dataset.score || "0");
            const scoreB = parseFloat(b.dataset.score || "0");

            if (type === "price-asc") return priceA - priceB;
            if (type === "price-desc") return priceB - priceA;
            if (type === "score-desc") return scoreB - scoreA;
            return 0; // default (orden original del HTML)
          });
        }

        if (tbody) {
          const sorted = type === "default" ? tableRows : sortElements(tableRows);
          sorted.forEach((row) => tbody.appendChild(row));
        }

        if (ul) {
          const sorted = type === "default" ? listItems : sortElements(listItems);
          sorted.forEach((item) => ul.appendChild(item));
        }

        buttons.forEach((btn) => {
          btn.setAttribute("aria-pressed", String(btn.dataset.sort === type));
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          applySort(btn.dataset.sort || "default");
        });
      });
    });
  })();
</script>
