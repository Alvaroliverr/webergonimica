---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import CrossCategoryLinks from "../../components/CrossCategoryLinks.astro";
import ContactStrip from "../../components/ContactStrip.astro";
import ReviewList from "../../components/ReviewList.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { getProductsByCategory } from "../../data/products";

const faqs = [
  {
    question: "¿Qué tamaño de monitor es el mejor para programar?",
    answer: "27 pulgadas es el estándar recomendado para programar: ofrece suficiente espacio vertical para tener dos archivos de código abiertos en paralelo o documentación al lado sin ocupar tanto como un ultrapanorámico.",
  },
  {
    question: "¿Merece la pena un brazo de monitor en vez del pie original?",
    answer: "Rotundamente sí. Un brazo de gas permite ajustar la altura exacta a tu línea de visión (evitando doblar el cuello) y libera todo el espacio de debajo en el escritorio para el teclado o el portátil.",
  },
];

const products = getProductsByCategory("monitores").sort(
  (a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro
);

const rows = products.map((p) => ({
  imageSrc: p.imagen,
  name: p.nombre,
  badge: p.insignia,
  price: p.precio_aproximado,
  previousPrice: p.precio_anterior,
  onSale: p.en_oferta,
  saleBadge: p.badge_oferta,
  loadCapacity: p.capacidad_carga,
  heightRange: p.ajuste,
  warranty: p.garantia,
  score: p.puntuacion_setuppro,
  amazonUrl: p.amazon_affiliate_link,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Top 10 monitores y soportes ergonómicos para trabajar (2026)",
  description: "Ranking comparativo de monitores de 27 pulgadas y brazos ergonómicos VESA analizados por ElDeskOps.",
  numberOfItems: products.length,
  itemListElement: products.map((p, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://www.eldeskops.com/${p.categoria}/${p.id}`,
    name: p.nombre,
    image: p.imagen,
  })),
};
---

<Layout
  title="Mejores Monitores para Trabajar y Programar 2026: 27 Pulgadas IPS"
  description="Guía y comparativa de los mejores monitores de 27 pulgadas IPS y brazos ergonómicos VESA para teletrabajo y programación en 2026. Opciones baratas y sin fatiga visual."
  ogImage={products[0].imagen}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="doc space-y-12">
    <nav>
      <Breadcrumbs items={[{ label: "Monitores y accesorios", href: "/monitores" }]} />
    </nav>

    <header>
      <h1>Top 10 monitores y soportes ergonómicos para trabajar</h1>
      <p>
        La pantalla es lo que miras entre 6 y 10 horas al día. Comparamos monitores de 27 pulgadas
        reales del mercado español junto con los accesorios que más impacto tienen en la ergonomía
        real del puesto: brazos articulados y soportes de altura ajustable. ¿Dudas entre tamaño o
        resolución? <a href="/guias/que-monitor-elegir-para-programar" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">Lee antes nuestra guía de compra</a>.
        Si vas a poner un brazo, comprueba antes la
        <a href="/guias/brazo-monitor-vesa-compatible" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">compatibilidad VESA de tu monitor</a>.
        Y si buscas lo más barato:
        <a href="/guias/monitor-para-programar-barato" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">monitores para programar por menos de 100 €</a>.
      </p>
    </header>

    <ContactStrip products={products.slice(0, 6)} size="md" eager />

    <section class="wide mb-10">
      <h2 class="mb-6">Comparativa de los {products.length} mejores modelos</h2>
      <ComparisonTable rows={rows} loadCapacityLabel="Panel / Resolución" heightRangeLabel="Refresco / Ajuste" />
      <p class="mt-8 text-slate-700 dark:text-slate-200">
        La puntuación ElDeskOps es una valoración editorial propia sobre 10, no una media matemática.
        <a href="/sobre-nosotros">Cómo la calculamos</a>.
      </p>
    </section>

    <section class="wide">
      <h2 class="mb-4">Análisis individuales</h2>
      <ReviewList products={products} />
    </section>

    <FaqAccordion heading="Preguntas frecuentes sobre monitores para programar" items={faqs} />

    <CrossCategoryLinks currentCategory="monitores" />
  </div>
</Layout>
