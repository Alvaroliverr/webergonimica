---
// Acordeón de FAQs que inyecta automáticamente su propio JSON-LD (FAQPage).
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  items: Faq[];
  heading?: string;
}

const { items, heading = "Preguntas frecuentes" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<section>
  <h2 class="mb-6">{heading}</h2>
  <div>
    {items.map((item) => (
      <details class="group" name="faq-item">
        <summary
          class="flex items-baseline justify-between gap-6 cursor-pointer list-none py-4 text-lg text-slate-900 dark:text-slate-50 hover:underline underline-offset-4"
        >
          {item.question}
          <span class="shrink-0 w-5 text-center text-slate-500 transition-transform duration-150 group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="pb-6 text-slate-700 dark:text-slate-200 max-w-[62ch]">
          {item.answer}
        </div>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
