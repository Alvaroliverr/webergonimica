---
// Componente de matriz de decisión rápida: "Cómprala si..." vs "Evítala si..."
// Ayuda al usuario a disipar dudas en 10 segundos y reduce la fricción de compra.

interface Props {
  productName: string;
  buyIf: string[];
  avoidIf: string[];
}

const { productName, buyIf, avoidIf } = Astro.props;
---

<section class="my-10 rounded-2xl border border-[var(--line)] bg-[var(--field)] p-6 sm:p-8 transition-colors duration-200">
  <div class="mb-6 flex flex-col gap-1">
    <span class="text-sm font-medium text-[var(--muted)]">Veredicto rápido de compra</span>
    <h3 class="text-xl sm:text-2xl font-bold text-[var(--field-ink)]">
      ¿Es la {productName} la opción adecuada para ti?
    </h3>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Columna: Cómprala si -->
    <div class="flex flex-col rounded-xl border border-emerald-500/20 bg-emerald-500/[0.03] p-5 sm:p-6 dark:border-emerald-400/20 dark:bg-emerald-400/[0.02]">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-bold shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </span>
        <h4 class="text-base sm:text-lg font-semibold text-emerald-900 dark:text-emerald-300">
          Te conviene si...
        </h4>
      </div>
      <ul class="space-y-3 text-sm sm:text-base leading-relaxed text-[var(--field-ink)]">
        {buyIf.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500 shrink-0"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Columna: Evítala si -->
    <div class="flex flex-col rounded-xl border border-rose-500/20 bg-rose-500/[0.03] p-5 sm:p-6 dark:border-rose-400/20 dark:bg-rose-400/[0.02]">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-rose-500/15 text-rose-600 dark:text-rose-400 font-bold shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </span>
        <h4 class="text-base sm:text-lg font-semibold text-rose-900 dark:text-rose-300">
          Mejor busca otra opción si...
        </h4>
      </div>
      <ul class="space-y-3 text-sm sm:text-base leading-relaxed text-[var(--field-ink)]">
        {avoidIf.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-rose-500 shrink-0"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
