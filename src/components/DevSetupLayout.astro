---
// Layout de "Setup por Entorno de Desarrollo" — recomendación de hardware según el motor/lenguaje.
// Diseño técnico y profesional, sin estética "gaming"/RGB.
interface MonitorSlot {
  role: string;
  purpose: string;
  spec: string;
}

interface Props {
  title: string;
  intro: string;
  monitors: MonitorSlot[];
  peripheralsNote: string;
}

const { title, intro, monitors, peripheralsNote } = Astro.props;
---

<section class="rounded-2xl border border-slate-200 dark:border-slate-700/50 bg-white dark:bg-slate-800 p-5 sm:p-8">
  <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-2">{title}</h2>
  <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-6 max-w-2xl">{intro}</p>

  <!-- Esquema visual de disposición de monitores -->
  <div class="grid sm:grid-cols-[2fr_1fr] gap-3 mb-6">
    {monitors.map((m) => (
      <div class="rounded-xl border-2 border-dashed border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-4 flex flex-col justify-between min-h-[140px]">
        <span class="inline-flex w-fit items-center rounded-md bg-slate-900 dark:bg-slate-50 text-white dark:text-slate-900 text-[11px] font-mono font-semibold px-2 py-1">
          {m.role}
        </span>
        <div>
          <p class="text-sm font-medium text-slate-900 dark:text-slate-50">{m.purpose}</p>
          <p class="text-xs font-metric text-slate-400 dark:text-slate-500 mt-0.5">{m.spec}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Tarjeta de periféricos esenciales -->
  <div class="rounded-xl bg-brand-50 dark:bg-slate-900 ring-1 ring-brand-100 dark:ring-slate-700/50 p-5 flex items-start gap-4">
    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white dark:bg-slate-800 text-brand-600 dark:text-cyan-400 ring-1 ring-brand-100 dark:ring-slate-700/50">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 9V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3m-12 0h12m-12 0a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2M9 13h.01M12 13h.01M15 13h.01M9 16h.01M12 16h.01M15 16h.01" />
      </svg>
    </span>
    <div>
      <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-50 mb-1">Periféricos esenciales</h3>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{peripheralsNote}</p>
    </div>
  </div>
</section>
