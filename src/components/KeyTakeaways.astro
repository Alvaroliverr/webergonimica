---
// <KeyTakeaways> — Bloque de veredicto rápido en 30 segundos optimizado para Google AI Overviews y Snippets destacados.
interface Point {
  label?: string;
  text: string;
}

interface Props {
  title?: string;
  points: Point[];
  note?: string;
}

const {
  title = "Veredicto clave en 30 segundos",
  points,
  note,
} = Astro.props;
---

<aside
  data-ui="quick-verdict"
  role="region"
  aria-label={title}
  class="bg-slate-100/80 dark:bg-slate-800/80 rounded-xl p-5 sm:p-6 mb-8 border border-slate-200/80 dark:border-slate-700/80"
>
  <div class="flex items-center gap-2.5 mb-4">
    <div class="w-7 h-7 rounded-lg bg-emerald-600/10 dark:bg-emerald-400/10 flex items-center justify-center shrink-0">
      <svg
        class="w-4 h-4 text-emerald-600 dark:text-emerald-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-50 m-0">
      {title}
    </h2>
  </div>

  <ul class="space-y-2.5 text-sm sm:text-base text-slate-700 dark:text-slate-200 m-0 p-0 list-none">
    {points.map((pt) => (
      <li class="flex items-start gap-2.5">
        <svg
          class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="leading-relaxed">
          {pt.label && <strong class="font-semibold text-slate-900 dark:text-slate-50">{pt.label}: </strong>}
          {pt.text}
        </span>
      </li>
    ))}
  </ul>

  {note && (
    <p class="mt-4 pt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400 m-0">
      {note}
    </p>
  )}
</aside>
