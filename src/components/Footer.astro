---
import AffiliateDisclosure from "./AffiliateDisclosure.astro";

const links = [
  { label: "Sillas", href: "/sillas-ergonomicas" },
  { label: "Escritorios", href: "/escritorios-elevables" },
  { label: "Monitores", href: "/monitores" },
  { label: "Guías", href: "/guias" },
  { label: "Sobre nosotros", href: "/sobre-nosotros" },
  { label: "Contacto", href: "/contacto" },
];
---

<footer class="mt-24 bg-[var(--field-2)] text-[var(--field-2-ink)] transition-colors duration-200">
  <div class="mx-auto max-w-[1600px] px-[var(--margin)] pt-14 pb-24">
    <AffiliateDisclosure />

    <div class="mt-16 grid gap-3 text-base md:grid-cols-[1fr_auto_1fr] md:items-baseline">
      <p class="text-[var(--muted)]">Comparativas de ergonomía y setups</p>
      <nav class="flex flex-wrap gap-x-6 gap-y-1" aria-label="Pie de página">
        {links.map((l) => (
          <a href={l.href} class="text-[var(--field-2-ink)] hover:underline underline-offset-4">{l.label}</a>
        ))}
      </nav>
      <p class="text-[var(--muted)] md:text-right">
        © {new Date().getFullYear()} ElDeskOps ·
        <a href="/privacidad" class="text-[var(--field-2-ink)] hover:underline underline-offset-4">Privacidad</a>
      </p>
    </div>
  </div>
</footer>
