---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import CrossCategoryLinks from "../../components/CrossCategoryLinks.astro";
import ContactStrip from "../../components/ContactStrip.astro";
import ReviewList from "../../components/ReviewList.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { getProductsByCategory } from "../../data/products";

const faqs = [
  {
    question: "¿Cuál es la mejor silla ergonómica para trabajar muchas horas?",
    answer: "Depende de tu presupuesto y postura, pero en nuestra comparativa la CLOUVOU Ergonomica (9.6/10) y la Marsail 6D (9.1/10, mejor calidad-precio) destacan por su soporte lumbar ajustable, clave para sesiones de 6-8 horas seguidas.",
  },
  {
    question: "¿Qué silla ergonómica es buena para programar o estudiar?",
    answer: "Para programar recomendamos priorizar el soporte lumbar ajustable y reposabrazos regulables sobre el precio: la SIHOO M18 es nuestra \"Elección Programadores\" por su equilibrio entre precio, valoraciones (15.500+) y ajuste.",
  },
  {
    question: "¿Merece la pena una silla ergonómica frente a una silla gaming?",
    answer: "Sí, para trabajo de oficina y programación: las sillas ergonómicas priorizan el soporte lumbar y la postura sobre la estética, mientras que las gaming suelen ser más rígidas y menos ajustables a largo plazo.",
  },
];

const products = getProductsByCategory("sillas-ergonomicas").sort(
  (a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro
);

const rows = products.map((p) => ({
  imageSrc: p.imagen,
  name: p.nombre,
  badge: p.insignia,
  price: p.precio_aproximado,
  loadCapacity: p.capacidad_carga,
  heightRange: p.ajuste,
  warranty: p.garantia,
  score: p.puntuacion_setuppro,
  amazonUrl: p.amazon_affiliate_link,
}));

---

<Layout
  title="Top 10 sillas ergonómicas para programadores 2026"
  description="Comparamos las 10 mejores sillas ergonómicas para programar y teletrabajo. Soporte lumbar, materiales y precio real de Amazon."
  ogImage={products[0].imagen}
>
  <div class="doc space-y-12">
    <nav>
      <Breadcrumbs items={[{ label: "Sillas ergonómicas", href: "/sillas-ergonomicas" }]} />
    </nav>

    <header>
      <h1>Top 10 sillas ergonómicas para programadores</h1>
      <p>
        Pasar más de seis horas sentado programando o en videollamadas pasa factura a la zona lumbar
        y las cervicales. Analizamos y comparamos las sillas que realmente marcan la diferencia,
        priorizando soporte lumbar ajustable, materiales transpirables y durabilidad frente a la
        estética. ¿Primera vez comprando una?
        <a href="/guias/como-elegir-silla-ergonomica" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">Lee antes nuestra guía de compra</a>,
        o si el presupuesto manda,
        <a href="/guias/sillas-ergonomicas-baratas" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">mira nuestras opciones más económicas</a>.
      </p>
    </header>

    <ContactStrip products={products.slice(0, 6)} size="md" eager />

    <section class="wide mb-10">
      <h2 class="mb-6">Comparativa de los {products.length} mejores modelos</h2>
      <ComparisonTable rows={rows} />
      <p class="mt-8 text-slate-700 dark:text-slate-200">
        La puntuación ElDeskOps es una valoración editorial propia sobre 10, no una media matemática.
        <a href="/sobre-nosotros">Cómo la calculamos</a>.
      </p>
    </section>

    <section class="wide">
      <h2 class="mb-4">Análisis individuales</h2>
      <ReviewList products={products} />
    </section>

    <FaqAccordion heading="Preguntas frecuentes sobre sillas ergonómicas" items={faqs} />

    <CrossCategoryLinks currentCategory="sillas-ergonomicas" />
  </div>
</Layout>
