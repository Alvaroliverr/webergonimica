---
interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
---

<div class="grid sm:grid-cols-2 gap-2">
  <div class="bg-slate-50 dark:bg-slate-800 p-6 sm:p-8">
    <h3 class="mb-4">Lo que nos convence</h3>
    <ul class="space-y-3">
      {pros.map((pro) => (
        <li class="flex items-start gap-3 text-slate-700 dark:text-slate-200">
          <span class="w-4 shrink-0 font-semibold text-slate-900 dark:text-slate-50" aria-hidden="true">+</span>
          <span>{pro}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="bg-slate-50 dark:bg-slate-800 p-6 sm:p-8">
    <h3 class="mb-4">Dónde falla</h3>
    <ul class="space-y-3">
      {cons.map((con) => (
        <li class="flex items-start gap-3 text-slate-700 dark:text-slate-200">
          <span class="w-4 shrink-0 font-semibold text-slate-900 dark:text-slate-50" aria-hidden="true">−</span>
          <span>{con}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
