---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import BackToTop from "../components/BackToTop.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Análisis independientes de ergonomía y setups de escritorio.",
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://setuppro.example").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="_ASz4l_uw8ADd5Lb2Dka3VkGMdERm6L1dxYleqLSYlw" />

    <!-- Preconnect a orígenes críticos: acelera fuentes e imágenes de producto (LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://m.media-amazon.com" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&display=swap"
      />
    </noscript>

    <SeoHead title={title} description={description} canonicalURL={canonicalURL} ogImage={ogImage} />
    <script is:inline>
      document.documentElement.classList.add("js");
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored ? stored === "dark" : prefersDark) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-svh flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-slate-900 focus:text-white focus:px-4 focus:py-2.5 focus:text-sm focus:font-medium dark:focus:bg-slate-50 dark:focus:text-slate-900"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <Analytics />
    <script>
      // Aparición escalonada de cada parte de la página al entrar en pantalla.
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal], .doc > :not(article), .doc > article > *, .doc h2");
      targets.forEach((el, i) => { if (!el.style.getPropertyValue("--i")) el.style.setProperty("--i", String(Math.min(i % 5, 4))); });
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting || en.boundingClientRect.top < 0) { en.target.classList.add("is-in"); io.unobserve(en.target); } });
        }, { rootMargin: "0px 0px -6% 0px", threshold: 0.04 });
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add("is-in"));
      }
    </script>
  </body>
</html>
