---
interface Props {
  currentCategory: "sillas-ergonomicas" | "escritorios-elevables" | "monitores";
}

const { currentCategory } = Astro.props;

const allCategories = [
  { id: "sillas-ergonomicas", label: "Sillas ergonómicas", href: "/sillas-ergonomicas", desc: "Soporte lumbar y malla transpirable" },
  { id: "escritorios-elevables", label: "Escritorios elevables", href: "/escritorios-elevables", desc: "Motor eléctrico y memoria de altura" },
  { id: "monitores", label: "Monitores y accesorios", href: "/monitores", desc: "Paneles de 27\" y brazos articulados" },
];

const otherCategories = allCategories.filter((c) => c.id !== currentCategory);
---

<section aria-label="Otras categorías relacionadas">
  <h2 class="mb-4">Completa tu setup</h2>
  <ul>
    {otherCategories.map((cat) => (
      <li>
        <a
          href={cat.href}
          class="group flex items-baseline justify-between gap-6 min-h-[56px] py-3 text-lg text-slate-900 dark:text-slate-50 transition-transform duration-200 hover:translate-x-1"
        >
          <span class="group-hover:underline underline-offset-4">{cat.label}</span>
          <span class="hidden sm:block text-base text-slate-500 text-right">{cat.desc}</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>
