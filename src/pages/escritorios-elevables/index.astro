---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import CrossCategoryLinks from "../../components/CrossCategoryLinks.astro";
import ContactStrip from "../../components/ContactStrip.astro";
import ReviewList from "../../components/ReviewList.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { getProductsByCategory } from "../../data/products";

const faqs = [
  {
    question: "¿Qué es un escritorio elevable?",
    answer: "Es un escritorio con un motor eléctrico (o mecanismo manual) que permite subir y bajar la altura del tablero, para alternar entre trabajar sentado y de pie sin cambiar de mueble. También se le llama \"standing desk\" o mesa regulable en altura.",
  },
  {
    question: "¿Cuánto cuesta un escritorio elevable?",
    answer: "En nuestra comparativa van desde 73,30 € (WOLTU, compacto) hasta 169,99 € (OffiGo, con cajón y USB integrados). La mayoría de modelos con buena valoración se mueven entre 85 € y 140 €.",
  },
  {
    question: "¿Cuál es el mejor escritorio elevable para programar?",
    answer: "El OffiGo Elevable con Cajón y USB es nuestra opción top por sus funciones extra, y el SONGMICS 160x70 destaca por tener el tablero más grande y el mayor volumen de opiniones (4.600+) de toda la comparativa, ideal si usas varios monitores.",
  },
];

const products = getProductsByCategory("escritorios-elevables").sort(
  (a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro
);

const rows = products.map((p) => ({
  imageSrc: p.imagen,
  name: p.nombre,
  badge: p.insignia,
  price: p.precio_aproximado,
  loadCapacity: p.capacidad_carga,
  heightRange: p.ajuste,
  warranty: p.garantia,
  score: p.puntuacion_setuppro,
  amazonUrl: p.amazon_affiliate_link,
}));

---

<Layout
  title="Top 10 escritorios elevables para programar 2026"
  description="Comparamos los 10 mejores escritorios elevables eléctricos para programar y teletrabajo. Precio, tamaño y memoria de altura reales."
  ogImage={products[0].imagen}
>
  <div class="doc space-y-12">
    <nav>
      <Breadcrumbs items={[{ label: "Escritorios elevables", href: "/escritorios-elevables" }]} />
    </nav>

    <header>
      <h1>Top 10 escritorios elevables para programar</h1>
      <p>
        Alternar entre sentado y de pie a lo largo del día reduce la fatiga acumulada en jornadas
        largas frente al ordenador. Comparamos escritorios eléctricos reales del mercado español,
        priorizando estabilidad del motor, tamaño del tablero y funciones extra como memorias de
        altura o gestión de cables. ¿No sabes por dónde empezar?
        <a href="/guias/como-elegir-escritorio-elevable" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">Lee antes nuestra guía de compra</a>.
      </p>
    </header>

    <ContactStrip products={products.slice(0, 6)} size="md" eager />

    <section class="wide mb-10">
      <h2 class="mb-6">Comparativa de los {products.length} mejores modelos</h2>
      <ComparisonTable rows={rows} />
      <p class="mt-8 text-slate-700 dark:text-slate-200">
        La puntuación ElDeskOps es una valoración editorial propia sobre 10, no una media matemática.
        <a href="/sobre-nosotros">Cómo la calculamos</a>.
      </p>
    </section>

    <section class="wide">
      <h2 class="mb-4">Análisis individuales</h2>
      <ReviewList products={products} />
    </section>

    <FaqAccordion heading="Preguntas frecuentes sobre escritorios elevables" items={faqs} />

    <CrossCategoryLinks currentCategory="escritorios-elevables" />
  </div>
</Layout>
