---
// Cómo encaja el hardware en el día a día técnico del usuario.
interface Props {
  softwareName: string;
  softwareNotes: string[];
  osIntegrations: { label: string; supported: boolean }[];
}

const { softwareName, softwareNotes, osIntegrations } = Astro.props;
---

<section class="bg-slate-50 dark:bg-slate-800 p-6 sm:p-10">
  <h3 class="mb-6 !text-2xl !font-normal">Integración en tu ecosistema de trabajo</h3>

  <div class="grid sm:grid-cols-2 gap-2">
    <div class="bg-white dark:bg-slate-900 p-6">
      <h4 class="text-lg text-slate-900 dark:text-slate-50">Software y automatización</h4>
      <p class="text-slate-500 mb-4">{softwareName}</p>
      <ul class="space-y-3">
        {softwareNotes.map((note) => (
          <li class="flex items-start gap-3 text-slate-700 dark:text-slate-200">
            <span class="w-4 shrink-0" aria-hidden="true">–</span>
            <span>{note}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-white dark:bg-slate-900 p-6">
      <h4 class="text-lg text-slate-900 dark:text-slate-50 mb-4">Integración OS y widgets</h4>
      <ul>
        {osIntegrations.map((item) => (
          <li class="flex items-baseline justify-between gap-4 min-h-[44px] py-2">
            <span class="text-slate-700 dark:text-slate-200">{item.label}</span>
            <span class={item.supported ? "text-slate-900 dark:text-slate-50 font-semibold" : "text-slate-500"}>
              {item.supported ? "Compatible" : "No disponible"}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
