---
// The "Verdict Box" — caja de decisión rápida, above the fold en cada review.
interface Spec {
  icon: "weight" | "ruler" | "shield";
  label: string;
  value: string;
}

interface Props {
  badge: string;
  productName: string;
  brand?: string;
  imageSrc: string;
  imageAlt: string;
  score: number; // sobre 10
  specs: Spec[];
  amazonUrl: string;
  priceNote?: string;
}

const {
  badge,
  productName,
  brand,
  imageSrc,
  imageAlt,
  score,
  specs,
  amazonUrl,
  priceNote = "Precio sujeto a cambios. Actualizado hoy.",
} = Astro.props;

const icons: Record<Spec["icon"], string> = {
  weight:
    'M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36-.7-.7M6.34 6.34l-.7-.7m12.72 0-.7.7M6.34 17.66l-.7.7M12 7a5 5 0 0 0-5 5c0 2 1.2 3.2 2 4h6c.8-.8 2-2 2-4a5 5 0 0 0-5-5Z',
  ruler:
    'M4 15.5 15.5 4l4.5 4.5L8.5 20 4 15.5Zm3-1.5 1.5 1.5M10 11.5 11.5 13M13 8.5 14.5 10',
  shield:
    'M12 3 4.5 6v5.5c0 4.7 3.2 8.7 7.5 10 4.3-1.3 7.5-5.3 7.5-10V6L12 3Zm-2 9 2 2 4-4',
};

const scorePct = Math.min(100, Math.max(0, (score / 10) * 100));
---

<section class="rounded-2xl border border-slate-200 bg-white shadow-card p-5 sm:p-8 dark:bg-slate-800 dark:border-slate-700/50 transition-colors duration-300">
  <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
    <!-- Imagen + Badge -->
    <div class="relative">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold px-3 py-1.5 mb-4 ring-1 ring-brand-100 dark:bg-brand-700/20 dark:text-cyan-400 dark:ring-brand-700/30">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2 9.5 7.5 3.5 8.3l4.3 4.2L6.7 18.5 12 15.7l5.3 2.8-1.1-6 4.3-4.2-6-.8L12 2Z" />
        </svg>
        {badge}
      </span>

      <div class="relative rounded-xl bg-slate-50 aspect-square flex items-center justify-center overflow-hidden dark:bg-slate-900">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="w-full h-full object-contain p-6"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          width="600"
          height="600"
        />
      </div>
    </div>

    <!-- Contenido -->
    <div>
      {brand && <p class="text-sm font-medium text-slate-400 mb-1">{brand}</p>}
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 leading-tight mb-4 dark:text-slate-50">
        {productName}
      </h1>

      <!-- Score -->
      <div class="flex items-center gap-3 mb-6">
        <div class="flex items-baseline gap-1 rounded-lg bg-slate-900 text-white px-3 py-1.5 dark:bg-slate-50 dark:text-slate-900">
          <span class="font-metric text-xl font-bold">{score.toFixed(1)}</span>
          <span class="font-metric text-xs text-slate-400 dark:text-slate-500">/ 10</span>
        </div>
        <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden max-w-[140px] dark:bg-slate-700/50">
          <div class="h-full rounded-full bg-brand-500 dark:bg-cyan-400" style={`width: ${scorePct}%`}></div>
        </div>
        <span class="text-sm text-slate-500 dark:text-slate-400">Puntuación SetupPro</span>
      </div>

      <!-- Specs rápidas -->
      <ul class="space-y-3 mb-7">
        {specs.map((spec) => (
          <li class="flex items-center gap-3 text-sm">
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-50 text-slate-500 ring-1 ring-slate-100 dark:bg-slate-900 dark:text-slate-400 dark:ring-slate-700/50">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[spec.icon]} />
              </svg>
            </span>
            <span class="text-slate-500 dark:text-slate-400">{spec.label}</span>
            <span class="font-metric font-medium text-slate-900 ml-auto dark:text-slate-50">{spec.value}</span>
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <a
        href={amazonUrl}
        target="_blank"
        rel="sponsored nofollow"
        class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-cta-600 px-6 py-4 text-base font-semibold text-white shadow-sm hover:bg-cta-700 hover:shadow-md active:scale-[0.99] transition-all duration-200 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:text-slate-900"
      >
        Consultar disponibilidad en Amazon
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6 21 12l-7.5 6M21 12H3" />
        </svg>
      </a>
      <p class="text-xs text-slate-400 text-center mt-2.5 dark:text-slate-500">{priceNote}</p>
    </div>
  </div>
</section>
