---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import CrossCategoryLinks from "../../components/CrossCategoryLinks.astro";
import ContactStrip from "../../components/ContactStrip.astro";
import ReviewList from "../../components/ReviewList.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { getProductsByCategory } from "../../data/products";

const faqs = [
  {
    question: "¿Qué monitor se recomienda para programar?",
    answer: "Para programar prioriza resolución sobre tasa de refresco: el Lenovo L27qe QHD (2560×1440) muestra más líneas de código sin reducir la fuente. Si el presupuesto manda, el PHILIPS 27E1N1100A o el KOORUI E2711F cubren bien lo esencial.",
  },
  {
    question: "¿Sirve un monitor vertical para programar?",
    answer: "Sí, es muy útil para leer código o documentación larga sin scroll horizontal. No hace falta comprar un monitor especial: con un brazo articulado con rotación pivot como el ErgoSolid F80 puedes girar 90° cualquier monitor estándar.",
  },
  {
    question: "¿Vale la pena un brazo articulado frente al pie del monitor?",
    answer: "Sí si te importa la ergonomía real: un brazo permite ajustar la altura exacta respecto a tus ojos y liberar espacio de escritorio, algo que el pie fijo de fábrica no permite en la mayoría de monitores.",
  },
];

const products = getProductsByCategory("monitores").sort(
  (a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro
);

const rows = products.map((p) => ({
  imageSrc: p.imagen,
  name: p.nombre,
  badge: p.insignia,
  price: p.precio_aproximado,
  loadCapacity: p.capacidad_carga,
  heightRange: p.ajuste,
  warranty: p.garantia,
  score: p.puntuacion_setuppro,
  amazonUrl: p.amazon_affiliate_link,
}));

---

<Layout
  title="Top 10 monitores para programar 2026: comparativa"
  description="Comparamos los 10 mejores monitores y accesorios para programar. Resolución, tasa de refresco y precio real de Amazon."
  ogImage={products[0].imagen}
>
  <div class="doc space-y-12">
    <nav>
      <Breadcrumbs items={[{ label: "Monitores y accesorios", href: "/monitores" }]} />
    </nav>

    <header>
      <h1>Top 10 monitores para programar</h1>
      <p>
        La pantalla es lo que miras entre 6 y 10 horas al día. Comparamos monitores de 27 pulgadas
        reales del mercado español junto con los accesorios que más impacto tienen en la ergonomía
        real del puesto: brazos articulados y soportes de altura ajustable. ¿Dudas entre tamaño o
        resolución? <a href="/guias/que-monitor-elegir-para-programar" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">Lee antes nuestra guía de compra</a>.
        Si vas a poner un brazo, comprueba antes la
        <a href="/guias/brazo-monitor-vesa-compatible" class="text-brand-600 dark:text-cyan-400 hover:underline font-medium">compatibilidad VESA de tu monitor</a>.
      </p>
    </header>

    <ContactStrip products={products.slice(0, 6)} size="md" eager />

    <section class="wide mb-10">
      <h2 class="mb-6">Comparativa de los {products.length} mejores modelos</h2>
      <ComparisonTable rows={rows} loadCapacityLabel="Panel / Resolución" heightRangeLabel="Refresco / Ajuste" />
      <p class="mt-8 text-slate-700 dark:text-slate-200">
        La puntuación ElDeskOps es una valoración editorial propia sobre 10, no una media matemática.
        <a href="/sobre-nosotros">Cómo la calculamos</a>.
      </p>
    </section>

    <section class="wide">
      <h2 class="mb-4">Análisis individuales</h2>
      <ReviewList products={products} />
    </section>

    <FaqAccordion heading="Preguntas frecuentes sobre monitores para programar" items={faqs} />

    <CrossCategoryLinks currentCategory="monitores" />
  </div>
</Layout>
