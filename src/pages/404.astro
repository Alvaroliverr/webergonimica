---
import Layout from "../layouts/Layout.astro";
import ContactStrip from "../components/ContactStrip.astro";
import { getAllProducts } from "../data/products";

const categories = [
  { name: "Sillas ergonómicas", href: "/sillas-ergonomicas", desc: "Soporte lumbar y malla transpirable" },
  { name: "Escritorios elevables", href: "/escritorios-elevables", desc: "Motor eléctrico y memoria de altura" },
  { name: "Monitores y accesorios", href: "/monitores", desc: "Paneles de 27\" y brazos articulados" },
];

const strip = [...getAllProducts()].sort((a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro).slice(0, 6);
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe o se ha movido."
>
  <div class="doc space-y-12">
    <header>
      <h1 data-reveal>Esta página no existe</h1>
      <p data-reveal style="--i:1">Puede que el enlace esté roto o que la página se haya movido. Vuelve al inicio o elige una categoría.</p>
      <p class="mt-8" data-reveal style="--i:2"><a class="btn" href="/">Volver al inicio</a></p>
    </header>

    <ul>
      {categories.map((cat, i) => (
        <li data-reveal style={`--i:${i + 1}`}>
          <a
            href={cat.href}
            class="group flex items-baseline justify-between gap-6 min-h-[56px] py-3 text-lg text-slate-900 dark:text-slate-50 transition-transform duration-200 hover:translate-x-1"
          >
            <span class="group-hover:underline underline-offset-4">{cat.name}</span>
            <span class="hidden sm:block text-base text-slate-500 text-right">{cat.desc}</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <ContactStrip products={strip} size="md" hint="Los productos mejor puntuados de la comparativa." />
  </div>
</Layout>
