---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactStrip from "../../components/ContactStrip.astro";
import { getAllProducts } from "../../data/products";

const strip = [...getAllProducts()].sort((a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro).slice(0, 6);

const guides = [
  { title: "Cómo elegir una silla ergonómica", href: "/guias/como-elegir-silla-ergonomica", excerpt: "Los 5 puntos clave según tu altura, horas de trabajo y presupuesto." },
  { title: "Las 5 mejores sillas ergonómicas baratas", href: "/guias/sillas-ergonomicas-baratas", excerpt: "Opciones económicas reales desde 56,99€, sin sacrificar lo esencial." },
  { title: "Silla ergonómica para 100 kg o más", href: "/guias/silla-ergonomica-para-100-kg", excerpt: "Qué mirar si pesas 100 kg o más y qué modelos declaran 150 kg de carga." },
  { title: "Silla ergonómica para personas altas", href: "/guias/silla-ergonomica-personas-altas", excerpt: "Respaldo, profundidad y altura del asiento: qué mirar si mides más de 1,85 m." },
  { title: "Brazo de monitor: cómo saber si es compatible (VESA)", href: "/guias/brazo-monitor-vesa-compatible", excerpt: "Qué es VESA y cómo comprobar en un minuto si tu monitor admite un brazo." },
  { title: "Setup para programar por presupuesto", href: "/guias/setup-programador-por-presupuesto", excerpt: "Silla, escritorio elevable y monitor: la mejor combinación del catálogo para cada presupuesto." },
  { title: "Escritorio elevable para dos monitores", href: "/guias/escritorio-elevable-dos-monitores", excerpt: "Qué ancho de tablero necesitas para dos pantallas de 24 o 27 pulgadas." },
  { title: "Escritorio elevable barato", href: "/guias/escritorio-elevable-barato", excerpt: "Los modelos de menos de 100 €, con su tamaño de tablero." },
  { title: "Monitor para programar por menos de 100 €", href: "/guias/monitor-para-programar-barato", excerpt: "Monitores de 27 pulgadas IPS baratos y qué te dan para programar." },
  { title: "Cómo elegir un escritorio elevable", href: "/guias/como-elegir-escritorio-elevable", excerpt: "Motor, tamaño de tablero, capacidad de carga y gestión de cables." },
  { title: "Qué monitor elegir para programar", href: "/guias/que-monitor-elegir-para-programar", excerpt: "Tamaño, resolución, distancia y tasa de refresco explicados sin tecnicismos." },
  { title: "Setup híbrido para desarrollo (Godot / Python)", href: "/guias/setup-godot-python", excerpt: "Disposición de monitores y periféricos para alternar entre el editor de nodos y scripts." },
];
---

<Layout
  title="Guías de ergonomía y setups para desarrolladores"
  description="Guías prácticas sobre ergonomía, disposición de monitores y setups de trabajo para programadores."
>
  <div class="doc space-y-8">
    <nav>
      <Breadcrumbs items={[{ label: "Guías", href: "/guias" }]} />
    </nav>

    <header>
      <h1>Guías de ergonomía y setups</h1>
      <p>
        Recomendaciones prácticas más allá de las reviews de producto individuales: disposición de
        monitores, cálculo de medidas ergonómicas y setups por entorno de desarrollo.
      </p>
    </header>

    <ContactStrip products={strip} size="md" hint="Los productos mejor puntuados de la comparativa." />

    <ul>
      {guides.map((guide, i) => (
        <li data-reveal style={`--i:${i % 5}`}>
          <a href={guide.href} class="group flex items-baseline justify-between gap-6 min-h-[72px] py-4 transition-transform duration-200 hover:translate-x-1">
            <span class="block">
              <span class="block text-xl text-slate-900 dark:text-slate-50 group-hover:underline underline-offset-4">{guide.title}</span>
              <span class="block mt-1 text-slate-600 dark:text-slate-300 max-w-[60ch]">{guide.excerpt}</span>
            </span>
            <span aria-hidden="true" class="text-slate-900 dark:text-slate-50">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
