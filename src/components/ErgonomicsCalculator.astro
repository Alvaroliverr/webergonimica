---
// Calculadora de Setup Ideal — lead magnet interactivo, vanilla JS ligero.
interface Props {
  deskCategoryUrl?: string;
}
const { deskCategoryUrl = "/escritorios-elevables" } = Astro.props;
---

<section
  id="ergo-calculator"
  data-desk-url={deskCategoryUrl}
  class="bg-slate-50 dark:bg-slate-800 p-6 sm:p-10"
>
  <h2 class="mb-3">Calculadora de Setup Ideal</h2>
  <p class="text-slate-700 dark:text-slate-300 mb-8 max-w-[60ch]">
    Introduce tu altura y calcula al instante las medidas ergonómicas recomendadas para tu silla, escritorio y monitor.
  </p>

  <div class="flex items-center gap-4 mb-8">
    <input
      type="range"
      id="height-slider"
      min="140"
      max="210"
      step="1"
      value="175"
      class="flex-1 h-11 bg-transparent accent-[var(--accent)] cursor-pointer"
    />
    <div class="flex items-baseline gap-1 bg-slate-900 dark:bg-slate-50 px-4 py-2 shrink-0">
      <input
        type="number"
        id="height-input"
        min="140"
        max="210"
        value="175"
        class="w-12 bg-transparent font-metric text-lg font-bold text-white dark:text-slate-900 text-right focus:outline-none"
      />
      <span class="font-metric text-xs text-slate-400 dark:text-slate-500">cm</span>
    </div>
  </div>

  <div class="grid sm:grid-cols-3 gap-2">
    <div class="bg-white dark:bg-slate-900 p-5">
      <p class="text-slate-500 mb-2">Altura ideal de silla (asiento)</p>
      <p class="font-metric text-2xl font-bold text-slate-900 dark:text-slate-50">
        <span id="result-chair">45</span> cm
      </p>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5">
      <p class="text-slate-500 mb-2">Escritorio: sentado / de pie</p>
      <p class="font-metric text-2xl font-bold text-slate-900 dark:text-slate-50">
        <span id="result-desk-sit">70</span> / <span id="result-desk-stand">110</span> cm
      </p>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5">
      <p class="text-slate-500 mb-2">Distancia óptima al monitor</p>
      <p class="font-metric text-2xl font-bold text-slate-900 dark:text-slate-50">
        <span id="result-monitor">63</span> cm
      </p>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button
      type="button"
      id="calc-copy-btn"
      class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-slate-200/80 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-100 transition-colors duration-150 cursor-pointer"
    >
      <svg class="w-4 h-4 shrink-0 text-slate-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span id="calc-copy-text">Copiar mis medidas</span>
    </button>

    <a
      id="calc-share-wa"
      href="https://api.whatsapp.com/send?text=Mis%20medidas%20ergon%C3%B3micas%20en%20https%3A%2F%2Fwww.eldeskops.com%2Fcalculadora-ergonomica"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-800 dark:text-emerald-300 transition-colors duration-150"
    >
      <svg class="w-4 h-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
      </svg>
      <span>Compartir en WhatsApp</span>
    </a>
  </div>

  <a
    id="calc-cta"
    href={deskCategoryUrl}
    class="btn mt-6 w-full !justify-between !min-h-[56px] gap-4 text-left"
  >
    <span>Ver escritorios que alcanzan los <span id="cta-height">110</span> cm recomendados para ti</span>
    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6 21 12l-7.5 6M21 12H3" />
    </svg>
  </a>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-600 dark:text-slate-400">
    <span>¿Buscas una silla adaptada a tu altura?</span>
    <a
      id="calc-chair-link"
      href="/sillas-ergonomicas"
      class="text-brand-600 dark:text-cyan-400 font-semibold hover:underline"
    >
      Ver sillas ergonómicas con ajuste de 45 cm →
    </a>
  </div>
</section>

<script>
  (function () {
    const root = document.getElementById("ergo-calculator");
    if (!root) return;

    const slider = root.querySelector<HTMLInputElement>("#height-slider")!;
    const numberInput = root.querySelector<HTMLInputElement>("#height-input")!;
    const resultChair = root.querySelector<HTMLElement>("#result-chair")!;
    const resultDeskSit = root.querySelector<HTMLElement>("#result-desk-sit")!;
    const resultDeskStand = root.querySelector<HTMLElement>("#result-desk-stand")!;
    const resultMonitor = root.querySelector<HTMLElement>("#result-monitor")!;
    const ctaHeight = root.querySelector<HTMLElement>("#cta-height")!;
    const chairLink = root.querySelector<HTMLAnchorElement>("#calc-chair-link");
    const copyBtn = root.querySelector<HTMLButtonElement>("#calc-copy-btn");
    const copyText = root.querySelector<HTMLElement>("#calc-copy-text");
    const shareWa = root.querySelector<HTMLAnchorElement>("#calc-share-wa");

    let currentMetrics = { height: 175, chair: 45, deskSit: 70, deskStand: 110, monitor: 63 };

    function clamp(v: number, min: number, max: number) {
      return Math.min(max, Math.max(min, v));
    }

    function compute(heightCm: number) {
      // Aproximaciones ergonómicas estándar basadas en proporciones antropométricas.
      const chairHeight = Math.round(heightCm * 0.26);
      const deskSitHeight = Math.round(heightCm * 0.4 + 2);
      const deskStandHeight = Math.round(heightCm * 0.65 - 4);
      const monitorDistance = Math.round(heightCm * 0.36);
      return { chairHeight, deskSitHeight, deskStandHeight, monitorDistance };
    }

    function render(heightCm: number) {
      const { chairHeight, deskSitHeight, deskStandHeight, monitorDistance } = compute(heightCm);
      currentMetrics = { height: heightCm, chair: chairHeight, deskSit: deskSitHeight, deskStand: deskStandHeight, monitor: monitorDistance };
      resultChair.textContent = String(chairHeight);
      resultDeskSit.textContent = String(deskSitHeight);
      resultDeskStand.textContent = String(deskStandHeight);
      resultMonitor.textContent = String(monitorDistance);
      ctaHeight.textContent = String(deskStandHeight);
      if (chairLink) {
        if (heightCm >= 183) {
          chairLink.href = "/guias/silla-ergonomica-personas-altas";
          chairLink.textContent = "Ver sillas ergonómicas recomendadas para personas altas (>1,83 m) →";
        } else {
          chairLink.href = "/sillas-ergonomicas";
          chairLink.textContent = "Ver sillas con asiento regulable a " + chairHeight + " cm →";
        }
      }
      if (shareWa) {
        const msg = `Mis medidas ergonómicas recomendadas (${heightCm} cm):\n- Silla: ${chairHeight} cm\n- Mesa sentado: ${deskSitHeight} cm\n- Mesa de pie: ${deskStandHeight} cm\n- Monitor: ${monitorDistance} cm\nCalcula las tuyas en: https://www.eldeskops.com/calculadora-ergonomica`;
        shareWa.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
      }
    }

    copyBtn?.addEventListener("click", async () => {
      const textToCopy = `Setup ergonómico recomendado para ${currentMetrics.height} cm de estatura:\n• Asiento de silla: ${currentMetrics.chair} cm\n• Escritorio sentado: ${currentMetrics.deskSit} cm\n• Escritorio de pie: ${currentMetrics.deskStand} cm\n• Distancia al monitor: ${currentMetrics.monitor} cm\nCalculado en https://www.eldeskops.com/calculadora-ergonomica`;
      try {
        await navigator.clipboard.writeText(textToCopy);
        if (copyText) copyText.textContent = "Copiado al portapapeles";
        setTimeout(() => {
          if (copyText) copyText.textContent = "Copiar mis medidas";
        }, 2000);
      } catch (err) {
        // Fallback en caso de que clipboard falle
      }
    });

    function update(value: number, source: "slider" | "number") {
      const clamped = clamp(value, 140, 210);
      slider.value = String(clamped);
      numberInput.value = String(clamped);
      render(clamped);
    }

    slider.addEventListener("input", () => update(Number(slider.value), "slider"));
    numberInput.addEventListener("input", () => {
      if (numberInput.value === "") return;
      update(Number(numberInput.value), "number");
    });
    numberInput.addEventListener("blur", () => update(Number(numberInput.value || 175), "number"));

    render(Number(slider.value));
  })();
</script>
