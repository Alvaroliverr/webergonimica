---
interface Props {
  name: string;
  role: string;
  bio: string;
  avatarSrc: string;
  updatedAt: string; // ej. "21 de septiembre de 2026"
}

const { name, role, bio, avatarSrc, updatedAt } = Astro.props;
---

<aside class="flex items-start gap-4 rounded-xl border border-slate-200 dark:border-slate-700/50 bg-slate-50 dark:bg-slate-800/60 p-5">
  <img
    src={avatarSrc}
    alt={`Foto de ${name}`}
    class="h-14 w-14 rounded-full object-cover ring-1 ring-slate-200 dark:ring-slate-700/50 shrink-0"
    width="56"
    height="56"
    loading="lazy"
  />
  <div class="min-w-0">
    <p class="text-sm font-semibold text-slate-900 dark:text-slate-50">
      Escrito y verificado por {name}
    </p>
    <p class="text-xs font-medium text-brand-600 dark:text-cyan-400 mb-2">{role}</p>
    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{bio}</p>
    <p class="text-xs text-slate-400 dark:text-slate-500 mt-2">Última actualización: {updatedAt}</p>
  </div>
</aside>
