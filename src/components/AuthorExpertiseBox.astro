---
interface Props {
  name: string;
  role: string;
  bio: string;
  avatarSrc?: string;
  updatedAt: string; // ej. "21 de septiembre de 2026"
}

const { name, role, bio, updatedAt } = Astro.props;
---

<aside class="bg-slate-50 dark:bg-slate-800 p-6 sm:p-8">
  <p class="text-slate-900 dark:text-slate-50">
    Escrito por <strong class="font-semibold">{name}</strong> · {role}
  </p>
  <p class="mt-3 text-slate-700 dark:text-slate-200 max-w-[62ch]">{bio}</p>
  <p class="mt-4 text-slate-500">Última actualización: {updatedAt}</p>
</aside>
