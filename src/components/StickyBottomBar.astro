---
// Barra inferior de conversión, solo móvil. Aparece tras superar el primer 25% de scroll.
import { resizeAmazonImage } from "../utils/image";

interface Props {
  productName: string;
  imageSrc: string;
  imageAlt: string;
  rating: number; // sobre 5
  amazonUrl: string;
}

const { productName, imageSrc, imageAlt, rating, amazonUrl } = Astro.props;
---

<div
  id="sticky-bottom-bar"
  class="md:hidden fixed inset-x-0 bottom-0 z-50 translate-y-full opacity-0 transition-[transform,opacity] duration-300 ease-out bg-[var(--ink)] text-white"
  data-sticky-bar
>
  <div class="flex items-center gap-3 px-4 py-3">
    <img
      src={resizeAmazonImage(imageSrc, 100)}
      alt={imageAlt}
      class="h-12 w-12 shrink-0 object-contain bg-white p-1"
      loading="lazy"
      width="48"
      height="48"
    />

    <div class="min-w-0 flex-1">
      <p class="truncate text-base text-white">{productName}</p>
      <p class="text-sm text-white/75">{String(rating).replace(".", ",")} de 5 en Amazon</p>
    </div>

    <a
      href={amazonUrl}
      target="_blank"
      rel="sponsored nofollow"
      class="btn shrink-0 !min-h-[44px] !px-4"
    >
      Ver en Amazon
    </a>
  </div>
</div>

<script>
  (function () {
    const bar = document.querySelector<HTMLElement>("[data-sticky-bar]");
    if (!bar) return;

    const THRESHOLD = 0.25;
    let visible = false;

    function onScroll() {
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      const shouldShow = progress >= THRESHOLD;

      if (shouldShow !== visible) {
        visible = shouldShow;
        bar!.classList.toggle("translate-y-full", !visible);
        bar!.classList.toggle("opacity-0", !visible);
        bar!.classList.toggle("translate-y-0", visible);
        bar!.classList.toggle("opacity-100", visible);
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
