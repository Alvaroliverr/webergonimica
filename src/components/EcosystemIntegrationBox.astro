---
// EcosystemIntegrationBox — cómo encaja el hardware en el día a día técnico del usuario.
// Para insertar en reseñas de ratones, teclados y monitores.
interface Props {
  softwareName: string;
  softwareNotes: string[];
  osIntegrations: { label: string; supported: boolean }[];
}

const { softwareName, softwareNotes, osIntegrations } = Astro.props;
---

<section class="rounded-2xl border border-slate-200 dark:border-slate-700/50 bg-white dark:bg-slate-800 overflow-hidden">
  <div class="px-5 sm:px-6 py-4 border-b border-slate-100 dark:border-slate-700/50">
    <h3 class="text-base font-semibold text-slate-900 dark:text-slate-50">Integración en tu ecosistema de trabajo</h3>
  </div>

  <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-100 dark:divide-slate-700/50">
    <!-- Columna 1: Software de gestión / macros -->
    <div class="p-5 sm:p-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 dark:bg-cyan-400/10 text-brand-600 dark:text-cyan-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17 15 12l-5.25-5M4 19h16" />
          </svg>
        </span>
        <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-50">Software y automatización</h4>
      </div>
      <p class="text-xs font-medium text-slate-400 dark:text-slate-500 mb-3">{softwareName}</p>
      <ul class="space-y-2">
        {softwareNotes.map((note) => (
          <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-slate-300 dark:bg-slate-600"></span>
            {note}
          </li>
        ))}
      </ul>
    </div>

    <!-- Columna 2: Integración OS / widgets -->
    <div class="p-5 sm:p-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 dark:bg-cyan-400/10 text-brand-600 dark:text-cyan-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h5l-1 3h8l-1-3h5a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2M4 6h16" />
          </svg>
        </span>
        <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-50">Integración OS y widgets</h4>
      </div>
      <ul class="space-y-2.5">
        {osIntegrations.map((item) => (
          <li class="flex items-center justify-between gap-2 text-sm">
            <span class="text-slate-600 dark:text-slate-300">{item.label}</span>
            {item.supported ? (
              <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Compatible
              </span>
            ) : (
              <span class="text-xs font-medium text-slate-400 dark:text-slate-500">No disponible</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
