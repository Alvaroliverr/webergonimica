---
// Componente de venta cruzada ergonómica (monetización secundaria inspirada en TopAspiradoras)
// Muestra accesorios esenciales que los compradores suelen añadir a la cesta junto al producto principal.
import rawAddons from "../data/addons.json";
import { resizeAmazonImage } from "../utils/image";

interface Props {
  currentCategory?: string;
  heading?: string;
  subheading?: string;
}

const {
  currentCategory = "sillas-ergonomicas",
  heading = "Completa tu setup: accesorios y mejoras ergonómicas",
  subheading = "Los complementos más recomendados para maximizar la postura, evitar dolores y cuidar tu espacio de trabajo.",
} = Astro.props;

// Mostramos primero los accesorios específicos de esta categoría y luego el resto
const allAddons = rawAddons.addons;
const relevantAddons = [
  ...allAddons.filter((a) => a.categoria_objetivo === currentCategory),
  ...allAddons.filter((a) => a.categoria_objetivo !== currentCategory),
].slice(0, 3);
---

<section class="my-14 rounded-2xl border border-[var(--line)] bg-[var(--field-2)] p-6 sm:p-8 transition-colors duration-200">
  <div class="mb-8">
    <span class="text-sm font-medium text-[var(--muted)]">Accesorios imprescindibles</span>
    <h3 class="text-xl sm:text-2xl font-bold text-[var(--field-2-ink)] mt-1">
      {heading}
    </h3>
    <p class="mt-2 text-sm sm:text-base text-[var(--muted)] max-w-2xl leading-relaxed">
      {subheading}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {relevantAddons.map((addon) => (
      <div class="flex flex-col justify-between rounded-xl border border-[var(--line)] bg-[var(--field)] p-5 transition-transform duration-150 hover:-translate-y-0.5">
        <div>
          <div class="relative flex items-center justify-center h-44 mb-4 rounded-lg bg-white overflow-hidden p-3">
            <img
              src={resizeAmazonImage(addon.imagen, 300)}
              alt={addon.nombre}
              width="200"
              height="200"
              loading="lazy"
              class="h-full w-full object-contain mix-blend-multiply"
            />
            <span class="absolute top-2 left-2 rounded-sm bg-slate-900/90 px-2 py-0.5 text-[11px] font-semibold text-white">
              {addon.badge}
            </span>
          </div>

          <h4 class="text-base font-bold text-[var(--field-ink)] leading-snug line-clamp-2">
            {addon.nombre}
          </h4>

          <p class="mt-2 text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
            {addon.descripcion}
          </p>
        </div>

        <div class="mt-5 pt-3 flex items-center justify-between gap-3">
          <div class="flex flex-col">
            <span class="text-[11px] text-[var(--muted)] font-medium">Precio orientativo</span>
            <span class="text-lg font-bold text-[var(--field-ink)] font-metric">{addon.precio}</span>
          </div>

          <a
            href={addon.amazon_link}
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3.5 py-2 text-xs font-semibold text-white transition-colors hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
          >
            <span>Ver en Amazon</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
