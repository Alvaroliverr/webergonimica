---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import VerdictBox from "../../components/VerdictBox.astro";
import ProsConsBlock from "../../components/ProsConsBlock.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import AuthorExpertiseBox from "../../components/AuthorExpertiseBox.astro";
import StickyBottomBar from "../../components/StickyBottomBar.astro";
import ErgonomicsCalculator from "../../components/ErgonomicsCalculator.astro";
import CrossCategoryLinks from "../../components/CrossCategoryLinks.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import ContactStrip from "../../components/ContactStrip.astro";
import { getProductsByCategory, getDecisionPoints } from "../../data/products";
import DecisionMatrix from "../../components/DecisionMatrix.astro";
import SetupAddons from "../../components/SetupAddons.astro";

const CATEGORY = "monitores";

export function getStaticPaths() {
  return getProductsByCategory("monitores").map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

const { buyIf, avoidIf } = getDecisionPoints(product);

// Alternativas: el resto de monitores y accesorios de la comparativa, ordenados por puntuación.
const alternatives = getProductsByCategory(CATEGORY)
  .filter((p) => p.id !== product.id)
  .sort((a, b) => b.puntuacion_setuppro - a.puntuacion_setuppro);

const comparisonRows = [product, ...alternatives].map((p) => ({
  imageSrc: p.imagen,
  name: p.nombre,
  badge: p.insignia,
  price: p.precio_aproximado,
  previousPrice: p.precio_anterior,
  onSale: p.en_oferta,
  saleBadge: p.badge_oferta,
  loadCapacity: p.capacidad_carga,
  heightRange: p.ajuste,
  warranty: p.garantia,
  score: p.puntuacion_setuppro,
  amazonUrl: p.amazon_affiliate_link,
}));

const faqs = product.preguntas_frecuentes.map((f: { pregunta: string; respuesta: string }) => ({
  question: f.pregunta,
  answer: f.respuesta,
}));

const todayIso = new Date().toISOString().split("T")[0];

const positiveNotesList = {
  "@type": "ItemList",
  itemListElement: product.pros.map((pro: string, i: number) => ({
    "@type": "ListItem",
    position: i + 1,
    name: pro,
  })),
};

const negativeNotesList = {
  "@type": "ItemList",
  itemListElement: product.contras.map((contra: string, i: number) => ({
    "@type": "ListItem",
    position: i + 1,
    name: contra,
  })),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Review",
  itemReviewed: {
    "@type": "Product",
    name: product.nombre,
    description: product.introduccion,
    brand: { "@type": "Brand", name: product.marca },
    image: product.imagen,
    offers: {
      "@type": "Offer",
      url: product.amazon_affiliate_link,
      priceCurrency: "EUR",
      price: product.precio_raw,
      availability: "https://schema.org/InStock",
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: product.valoracion_amazon,
      reviewCount: product.num_opiniones,
    },
    positiveNotes: positiveNotesList,
    negativeNotes: negativeNotesList,
  },
  positiveNotes: positiveNotesList,
  negativeNotes: negativeNotesList,
  author: {
    "@type": "Organization",
    name: "ElDeskOps",
    url: "https://www.eldeskops.com/sobre-nosotros",
  },
  reviewRating: {
    "@type": "Rating",
    ratingValue: product.puntuacion_setuppro,
    bestRating: 10,
  },
  datePublished: "2026-09-01",
  dateModified: todayIso,
};
---

<Layout
  title={`${product.nombre} Opiniones y Análisis 2026: ¿Vale la pena? | ElDeskOps`}
  description={`${product.nombre}: opiniones, resolución y ergonomía visual (${product.precio_aproximado}), ${String(product.valoracion_amazon).replace(".", ",")} de 5 en ${product.num_opiniones.toLocaleString("es-ES", { useGrouping: "always" })} opiniones de Amazon.es. Pros, contras y a quién le conviene.`}
  ogImage={product.imagen}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="doc">
    <nav>
      <Breadcrumbs
        items={[
          { label: "Monitores y accesorios", href: "/monitores" },
          { label: product.nombre, href: `/monitores/${product.id}` },
        ]}
      />
    </nav>

    <article class="space-y-14">
      <header class="wide">
        <aside aria-label="Compra rápida">
          <VerdictBox
            badge={product.insignia}
            productName={`${product.nombre}: análisis y opinión`}
            brand={product.marca}
            imageSrc={product.imagen}
            imageAlt={`Foto de ${product.nombre}`}
            score={product.puntuacion_setuppro}
            amazonUrl={product.amazon_affiliate_link}
            price={product.precio_aproximado}
            previousPrice={product.precio_anterior}
            onSale={product.en_oferta}
            saleBadge={product.badge_oferta}
            specs={[
              { icon: "weight", label: "Panel / Resolución", value: product.capacidad_carga },
              { icon: "ruler", label: "Refresco / Ajuste", value: product.ajuste },
              { icon: "shield", label: "Valoración", value: `${product.valoracion_amazon} / 5` },
            ]}
          />
        </aside>
      </header>

      <section>
        <h2 class="mb-4">Por qué elegimos el {product.nombre}</h2>
        <p class="leading-relaxed mb-4">{product.introduccion}</p>
        <h3 class="mb-2">Materiales y construcción</h3>
        <p class="leading-relaxed">{product.materiales}</p>
      </section>

      <section>
        <h2 class="mb-4">Inconvenientes</h2>
        <ProsConsBlock pros={product.pros} cons={product.contras} />
        <DecisionMatrix productName={product.nombre} buyIf={buyIf} avoidIf={avoidIf} />
      </section>

      <ErgonomicsCalculator deskCategoryUrl="/escritorios-elevables" />

      <section class="wide">
        <h2 class="mb-6">Alternativas a considerar</h2>
        <ContactStrip products={[product, ...alternatives].slice(0, 6)} size="md" />
        <div class="mt-10">
          <ComparisonTable rows={comparisonRows} loadCapacityLabel="Panel / Resolución" heightRangeLabel="Refresco / Ajuste" />
        </div>
      </section>

      <SetupAddons currentCategory="monitores" heading="Optimiza la ergonomía de tu monitor" />

      <FaqAccordion heading="Otras preguntas de los usuarios" items={faqs} />

      <RelatedGuides category="monitores" />

      <CrossCategoryLinks currentCategory="monitores" />

      <AuthorExpertiseBox
        name="Equipo ElDeskOps"
        role="Redacción · Análisis de producto"
        bio="Esta comparativa se elabora contrastando especificaciones técnicas del fabricante, valoraciones verificadas de compradores reales en Amazon y precios revisados en Amazon.es. No sustituye una prueba física exhaustiva de cada modelo, pero sí una investigación rigurosa y actualizada de cada ficha de producto."
        avatarSrc="https://placehold.co/112x112/e2e8f0/475569?text=SP"
        updatedAt="9 de noviembre de 2026"
      />
    </article>
  </div>

  <StickyBottomBar
    productName={product.nombre}
    imageSrc={product.imagen}
    imageAlt={`Foto de ${product.nombre}`}
    rating={product.valoracion_amazon}
    amazonUrl={product.amazon_affiliate_link}
    price={product.precio_aproximado}
    previousPrice={product.precio_anterior}
    onSale={product.en_oferta}
    saleBadge={product.badge_oferta}
  />
</Layout>
