---
interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
---

<div class="grid sm:grid-cols-2 gap-4">
  <div class="rounded-xl border border-emerald-100 bg-emerald-50/40 p-5 dark:bg-emerald-500/5 dark:border-emerald-500/20">
    <h3 class="text-sm font-semibold text-emerald-800 mb-3 dark:text-emerald-400">Lo que nos convence</h3>
    <ul class="space-y-2.5">
      {pros.map((pro) => (
        <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300">
          <span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white text-[10px]">✓</span>
          {pro}
        </li>
      ))}
    </ul>
  </div>

  <div class="rounded-xl border border-rose-100 bg-rose-50/40 p-5 dark:bg-rose-500/5 dark:border-rose-500/20">
    <h3 class="text-sm font-semibold text-rose-800 mb-3 dark:text-rose-400">Dónde falla</h3>
    <ul class="space-y-2.5">
      {cons.map((con) => (
        <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300">
          <span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-rose-400 text-white text-[10px]">✕</span>
          {con}
        </li>
      ))}
    </ul>
  </div>
</div>
